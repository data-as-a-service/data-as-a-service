# Copy this file to .env and set credentials for a SQL Server reachable from Docker.
# On Docker Desktop, host.docker.internal can reach SQL Server running on Windows.
# Enable TCP/IP and SQL authentication on the SQL Server instance first.
DAAS_CONNECTION_STRING=Server=host.docker.internal,1433;Database=Daas;User Id=daas_app;Password=replace-with-a-secret;Encrypt=False;TrustServerCertificate=True
